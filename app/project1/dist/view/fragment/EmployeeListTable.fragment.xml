<core:FragmentDefinition
    xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:l="sap.ui.layout">
    <!--Start Employee List text -->
   <FlexBox height="50px" />
<VBox width="100%" >
<Table
            id="employeeTable"
            items="{EmployeeList>/EmployeeTable}"
            inset="false"
            fixedLayout="true"
            class="sapUiResponsiveMargin"
            width="100%">

            <!-- Cột tiêu đề -->
            <columns>
                <Column><Text text="{i18n>InputName}"/></Column>
                <Column><Text text="{i18n>Department}"/></Column>
                <Column><Text text="{i18n>Email}"/></Column>
                <Column><Text text="{i18n>Level}"/></Column>
                <!-- <Column><Text text="{i18n>Gender}"/></Column>
                 <Column><Text text="{i18n>DateOfBirth}" /></Column>
                <Column><Text text="{i18n>WorkingFrom}"/></Column> -->
                <Column><Text text=""/></Column>
               
            </columns>

            <!-- Dữ liệu hàng -->
            <items>
                <ColumnListItem>
                    <cells>
                      
                        <Text text="{EmployeeList>Name}" />
                        <Text text="{EmployeeList>Department}" />
                        <Text text="{EmployeeList>Email}" />
                        <Text text="{EmployeeList>RoleName}" />
                        <!-- <Text text="{EmployeeList>Gender}" />
                        <Text text="{EmployeeList>DateOfBirth}" />
                        <Text text="{EmployeeList>WorkingFrom}" /> -->
                        <Button  text=">>" press="onPressDetail" />
                    </cells>
                </ColumnListItem>
            </items>

        </Table>

</VBox>
 
</core:FragmentDefinition>
