<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:unified="sap.ui.unified"
>
  <VBox width="100%" alignItems="End" >
    <HBox height="5px"  >
        <Button 
         id="id.btn.submit"
         text="Submit" 
         class="myButton"
         press="onSubmit"
        />
       <Button 
         id="id.btn.save"
         text="Save" 
         class="myButton"
         press="onSave"
         visible="false"
        />
           <Button 
         id="id.btn.caculate"
         text="Caculate Salary" 
         class="myButton"
         press="onCaculate"
         visible="false"
        />
    </HBox>
  </VBox>

</core:FragmentDefinition>