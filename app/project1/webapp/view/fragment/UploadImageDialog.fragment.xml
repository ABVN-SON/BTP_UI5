<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified">

    <Dialog
        id="uploadImageDialog"
        title="Upload Image"
        contentWidth="400px"
        draggable="true"
        resizable="true"
        afterClose="onUploadDialogClose">

        <VBox class="sapUiSmallMargin">
            <Text text="Choose an image to upload:" />
            <unified:FileUploader
                id="dialogFileUploader"
                fileType="jpg,jpeg,png"
                mimeType="image/jpeg,image/png"
                maximumFileSize="5"
                change="onPopupFileChange"
                width="100%" />
        </VBox>

        <beginButton>
            <Button text="Upload" press="onConfirmUpload" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseUploadDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
