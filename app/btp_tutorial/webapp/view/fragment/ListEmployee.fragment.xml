<core:FragmentDefinition
    xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:l="sap.ui.layout">
    <!--Start Employee List text -->
    <VBox class="sapUiMediumMarginBottom">
        <HBox justifyContent="SpaceBetween">
            <FlexBox height="20%" displayInline="true" justifyContent="Center" width="200px" class="myFlexBox">
                <Text text="{i18n>EmployeeList}" class="myInformationText"/>
            </FlexBox>
            <FlexBox height="20%" justifyContent="Center" width="100px">
              
            </FlexBox>
        </HBox>
    </VBox>
    <!--End Employee List text --> 
   <VBox width="100%"> 
   <HBox >
     <Label text="{i18n>Department}" class="sapUiTinyMargin minWith" labelFor="EmployeeList.SelectDepartment" wrapping="true"/>
     <Select forceSelection="true" id="idEmployeeList.SelectDepartment" change=".onChangeDepartment" items="{EmployeeList>/DepartmentTypes}" selectedItem="{EmployeeList>Key}" >
                <core:Item key="{EmployeeList>keyID}" text="{EmployeeList>Text}"/>
              
      </Select>
     </HBox>
     <FlexBox  height="10px"/>
     
        <HBox >
     <Label text="{i18n>Level}" class="sapUiTinyMargin minWith" labelFor="EmployeeList.SelectDepartment" wrapping="true"/>
     <Select forceSelection="true" id="idEmployeeList.SelectRange" change=".onChangeRange" items="{EmployeeList>/RangeTypes}" >
                <core:Item key="{EmployeeList>keyID}" text="{EmployeeList>Text}"/>
              
      </Select>
     </HBox>
   </VBox>

   <FlexBox  height="50px"/>
    
 
</core:FragmentDefinition>
